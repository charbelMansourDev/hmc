# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (use a separate database for dev and prod)
MONGODB_URI=

# 32+ random characters, e.g. `openssl rand -base64 48`
SESSION_SECRET=

# The single CMS account, created by `npm run seed`
ADMIN_USERNAME=
ADMIN_PASSWORD=

# Public base URL, used for links in notification emails
APP_URL=http://localhost:3000

# Vercel Blob (production uploads). When unset, uploads go to ./uploads
BLOB_READ_WRITE_TOKEN=

# Optional: appointment notification email. Disabled unless all are set.
SMTP_HOST=
SMTP_PORT=
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
APPOINTMENT_NOTIFY_TO=
